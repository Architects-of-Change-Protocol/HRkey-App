# ============================================================================
# HRKey Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
#
# IMPORTANT: Never commit .env to git (it's in .gitignore)
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NOTE (Hibernation Audit): code in this repo reads this SAME secret under
# THREE different names depending on the module — set ALL of them to the
# same value or the corresponding code path will silently fail to
# authenticate. See docs/HIBERNATION_AUDIT.md ("Environment Variables").
SUPABASE_SERVICE_ROLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Frontend (Next.js) reads the public config under the NEXT_PUBLIC_ prefix:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Direct Postgres connection string (used by some scripts/services alongside
# the REST/service-role credentials above):
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================================================
# STRIPE CONFIGURATION (REQUIRED for payments)
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# RESEND EMAIL CONFIGURATION (REQUIRED for emails)
# ============================================================================
# Get from: https://resend.com/api-keys

RESEND_API_KEY=re_...

# ============================================================================
# OPENAI CONFIGURATION (REQUIRED for AI refinement feature)
# ============================================================================
# Get from: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# URL CONFIGURATION
# ============================================================================

# Frontend URL (where your Vercel deployment is hosted)
FRONTEND_URL=https://your-app.vercel.app

# Backend URL (where your Render deployment is hosted)
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# ============================================================================
# ADMIN CONFIGURATION (OPTIONAL)
# ============================================================================

# Email of the user who should be auto-assigned as superadmin
HRKEY_SUPERADMIN_EMAIL=admin@yourdomain.com

# ============================================================================
# SERVER CONFIGURATION (OPTIONAL)
# ============================================================================

# Port for local development (Render auto-assigns in production)
PORT=3001

# Node environment
NODE_ENV=development

# ============================================================================
# ADDED BY HIBERNATION AUDIT — previously undocumented but read via
# process.env in the codebase. See docs/HIBERNATION_AUDIT.md for the file(s)
# each one comes from. Grouped by subsystem; NOT all are required for every
# deployment — verify against the feature you actually use before relying on
# a default.
# ============================================================================

# --- Auth / security -------------------------------------------------------
JWT_SECRET=
ADMIN_KEY=
HRKEY_ADMIN_KEY=
ENCRYPTION_KEY=
INVITE_IP_SALT=
CORS_ORIGINS=
# Only ever set to true in test/CI runs — never in production.
ALLOW_TEST_AUTH_BYPASS=false

# --- Sentry error monitoring -------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_DEFAULT=
RATE_LIMIT_API_MAX=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_HRSCORE_MAX=
RATE_LIMIT_STRICT_MAX=
RATE_LIMIT_SUBMIT_MAX=
RATE_LIMIT_SUBMIT_WINDOW_MS=
RATE_LIMIT_TOKEN_MAX=
RATE_LIMIT_ALLOWLIST=

# --- Stripe pricing ----------------------------------------------------------
STRIPE_PRICE_ID=
PRICE_ID_PRO=
PRICE_ID_ANNUAL=
PRICE_ID_LIFETIME=

# --- Email (secondary to Resend) ---------------------------------------------
RESEND_FROM_EMAIL=
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=
EMAIL_USER=
EMAIL_PASS=

# --- AI / embeddings -----------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=

# --- AOC / trust-runtime monetization layer -----------------------------------
USE_AOC_TRUST_RUNTIME=false
AOC_RUNTIME_BASE_URL=
AOC_RUNTIME_API_KEY=
AOC_RUNTIME_MODE=
AOC_ACCESS_PRICE_BASE=
AOC_PLATFORM_FEE_RATIO=
AOC_PLATFORM_USER_ID=
AOC_RLUSD_RATE=
AOC_BASE_URL=
AOC_API_KEY=
AOC_ENFORCE=
AOC_TEST_BYPASS=false
AOC_ALLOW_HEADER_CAPABILITY=false

# --- RLUSD payment rail (see also .env.payment-rail.example) ------------------
RLUSD_CONVERSION_FEE_RATIO=
RLUSD_MIN_CONVERSION_AOC=
RLUSD_MIN_WITHDRAWAL=
RLUSD_QUOTE_TTL_SECONDS=
RLUSD_SINPE_MOBILE_ENABLED=false
RLUSD_WITHDRAWALS_ENABLED=false
RLUSD_WITHDRAWAL_FEE_FIXED=
RLUSD_WITHDRAWAL_FEE_RATIO=

# --- HRKey marketplace/referral business rules --------------------------------
HRKEY_PLATFORM_ADDRESS=
HRKEY_PLATFORM_USER_ID=
HRKEY_DEFAULT_REFERENCE_PRICE=
HRKEY_REFEREE_SHARE_RATIO=
DATA_ACCESS_TIER_FULL_DATA=
DATA_ACCESS_TIER_PROFILE=
DATA_ACCESS_TIER_REFERENCE=
ENABLE_CANONICAL_REFEREE_RELATIONSHIP_EDGES=false
STAKE_CACHE_MAX_AGE_HOURS=

# --- Coinbase (wallet onramp / OnchainKit) ------------------------------------
NEXT_PUBLIC_CDP_API_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Contracts / chain (see .env.payment-rail.example for the fuller set) ------
CHAIN_ID=
BASE_MAINNET_RPC=
BASE_SEPOLIA_RPC_URL=
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=
ANCHOR_SIGNER_ADDRESS=
PROOF_CONTRACT_ADDRESS=
PROOF_SIGNER_PRIVATE_KEY=
CONTRACT_ADDRESS=
ISSUER_ADDRESS=
PLATFORM_ADDRESS=

# --- URLs (naming varies by module — set the ones your deployment needs) ------
API_BASE_URL=
APP_BACKEND_URL=
APP_URL=
PUBLIC_APP_URL=
PUBLIC_BASE_URL=

# --- Misc / feature flags ------------------------------------------------------
LOG_LEVEL=info
DEBUG=false
ENABLE_TEST_LOGS=false
